{
  "name": "@grounded/client",
  "version": "0.1.0",
  "description": "Grounded API client — a thin typed fetch wrapper.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@grounded/core": "workspace:*"
  },
  "devDependencies": {
    "@grounded/api": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flexxdev3/grounded-core.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/flexxdev3/grounded-core#readme",
  "bugs": {
    "url": "https://github.com/flexxdev3/grounded-core/issues"
  },
  "keywords": [
    "grounded",
    "client",
    "memory",
    "api-client"
  ],
  "engines": {
    "node": ">=20"
  }
}
