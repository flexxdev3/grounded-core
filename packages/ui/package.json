  },
  "dependencies": {
    "@grounded/client": "workspace:*",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@grounded/core": "workspace:*",
    "@preact/preset-vite": "^2.9.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grounded/grounded.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/grounded/grounded#readme",
  "bugs": {
    "url": "https://github.com/grounded/grounded/issues"
  },
  "keywords": [
    "grounded",
    "console",
    "ui"
  ],
  "engines": {
    "node": ">=20"
  }
