{
  "name": "@grounded/ui",
  "version": "0.1.0",
  "description": "Grounded console — a small web UI (not a chat app) over the API.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
