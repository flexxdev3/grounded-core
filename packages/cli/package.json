{
  "name": "@grounded/cli",
  "version": "0.1.0",
  "description": "Grounded installer — the `grounded` command (install/manage the service).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "grounded": "./dist/bin.js"
  },
  "files": [
    "dist",
    "hooks"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@grounded/core": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
