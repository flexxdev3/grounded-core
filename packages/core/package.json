{
  "name": "@grounded/core",
  "version": "0.1.0",
  "description": "Grounded core \u2014 storage/embedding adapters, hybrid recall engine, ingest, config.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./delivery": {
      "types": "./dist/engine/delivery.d.ts",
      "import": "./dist/engine/delivery.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.0",
    "sqlite-vec": "^0.1.9",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grounded/grounded.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/grounded/grounded#readme",
  "bugs": {
    "url": "https://github.com/grounded/grounded/issues"
  },
  "keywords": [
    "memory",
    "recall",
    "embeddings",
    "agents",
    "mcp",
    "sqlite",
    "pgvector"
  ],
  "engines": {
    "node": ">=20"
  }
}
