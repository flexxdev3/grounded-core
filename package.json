{
  "name": "grounded-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Grounded — self-hosted continuity for multi-agent workspaces",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache",
    "ground": "pnpm --filter @grounded/cli exec ground"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
